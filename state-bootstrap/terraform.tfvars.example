# Copy to terraform.tfvars (git-ignored) and fill in.
github_repo  = "<owner>/<repo>"

# Only if the repo uses immutable OIDC subject claims (check the README):
# github_subject_prefix = "repo:<owner>@<owner_id>/<repo>@<repo_id>"
aws_region   = "eu-central-1"
project_name = "mariam-va"

# Set to false if the account already has the GitHub OIDC provider.
create_github_oidc_provider = true
